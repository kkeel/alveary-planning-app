# Optional public configuration only. The development dashboard is the fallback.
# NEXT_PUBLIC_ALVEARY_DASHBOARD_URL=https://alveary.org/alveary-2027-2028/dashboard-test

# PUBLIC Supabase browser connection (already used by the sign-in pilot).
# GitHub Actions supplies these from repository VARIABLES when building.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Never commit Airtable PATs, Memberstack client secrets, Supabase secret/service-role
# keys, database passwords, or tokens used for GitHub Actions publishing.
# Those belong in a secret store and must never be NEXT_PUBLIC_ variables.
